{
  "name": "devhub-mcp",
  "version": "0.3.0",
  "private": true,
  "description": "Personal developer and career assistant MCP server: projects, tasks, job applications, TODOs and a local dashboard",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc",
    "start": "node --env-file=.env build/index.js",
    "web": "npm run build && node --env-file=.env build/web/main.js",
    "test": "npm run build && node --test \"build/**/*.test.js\""
  },
  "keywords": ["mcp", "model-context-protocol", "sqlite", "typescript", "developer-tools"],
  "author": "Tharun",
  "license": "ISC",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "typescript": "^7.0.2"
  }
}
