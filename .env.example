# Absolute path to the folder where DevHub stores its database
DEVHUB_DATA_DIR=C:\path\to\your\devhub-data

# Optional: only read project files (README, TODO scan) inside these folders.
# Separate several folders with ";". Leave empty to allow any project folder.
DEVHUB_ALLOWED_ROOTS=D:\;C:\Users\you\projects

# Optional: port for the local dashboard (npm run web). Defaults to 4321.
DEVHUB_WEB_PORT=4321
